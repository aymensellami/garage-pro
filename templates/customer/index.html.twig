{% extends 'base.html.twig' %}
{% block title %}Clients — GaragePro{% endblock %}
{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-white">👥 Clients</h2>
    <a href="{{ path('app_customer_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Ajouter</a>
</div>
<div class="gp-card p-0 overflow-hidden">
    <table class="table table-dark-custom mb-0">
        <thead><tr><th>Nom</th><th>Email</th><th>Téléphone</th><th>Véhicules</th><th>Total dépensé</th><th></th></tr></thead>
        <tbody>
        {% for c in customers %}
            <tr>
                <td><strong>{{ c.fullName }}</strong></td>
                <td>{{ c.email }}</td>
                <td>{{ c.phone ?: '-' }}</td>
                <td>{{ c.vehicles|length }}</td>
                <td>{{ c.totalSpent|number_format(2, ',', ' ') }} €</td>
                <td><a href="{{ path('app_customer_show', {id: c.id}) }}" class="btn btn-sm btn-outline-primary">Détails</a></td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
