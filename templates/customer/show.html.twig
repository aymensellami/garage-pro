{% extends 'base.html.twig' %}
{% block title %}{{ customer.fullName }} — GaragePro{% endblock %}
{% block body %}
<div class="row g-4">
    <div class="col-md-4">
        <div class="gp-card p-4">
            <h4 class="text-white">{{ customer.fullName }}</h4>
            <ul class="list-unstyled text-light mt-3">
                <li><i class="bi bi-envelope me-2"></i>{{ customer.email }}</li>
                <li><i class="bi bi-telephone me-2"></i>{{ customer.phone ?: 'Non renseigné' }}</li>
                <li><i class="bi bi-geo-alt me-2"></i>{{ customer.address ?: 'Non renseigné' }}</li>
            </ul>
            <a href="{{ path('app_customer_edit', {id: customer.id}) }}" class="btn btn-outline-primary btn-sm">Modifier</a>
        </div>
    </div>
    <div class="col-md-8">
        <div class="gp-card p-4">
            <h5 class="text-white mb-3">🚗 Véhicules</h5>
            {% for v in customer.vehicles %}
                <div class="d-flex justify-content-between border-bottom border-secondary pb-2 mb-2">
                    <div><strong class="text-white">{{ v.brand }} {{ v.model }}</strong><div class="small text-muted">{{ v.registration }} · {{ v.mileage|number_format(0, ' ', ' ') }} km</div></div>
                    <a href="{{ path('app_vehicle_show', {id: v.id}) }}" class="btn btn-sm btn-outline-light">Voir</a>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
