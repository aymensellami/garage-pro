{% extends 'base.html.twig' %}
{% block title %}Nouveau client — GaragePro{% endblock %}
{% block body %}
<h2 class="text-white mb-4">👤 Nouveau client</h2>
<div class="gp-card p-4">
    {{ form_start(form) }}
    <div class="row g-3">
        <div class="col-md-6">{{ form_row(form.firstName) }}</div>
        <div class="col-md-6">{{ form_row(form.lastName) }}</div>
        <div class="col-md-6">{{ form_row(form.email) }}</div>
        <div class="col-md-6">{{ form_row(form.phone) }}</div>
        <div class="col-md-8">{{ form_row(form.address) }}</div>
        <div class="col-md-4">{{ form_row(form.city) }}</div>
        <div class="col-md-4">{{ form_row(form.postalCode) }}</div>
    </div>
    <button class="btn btn-primary mt-3">Enregistrer</button>
    <a href="{{ path('app_customer_index') }}" class="btn btn-outline-secondary mt-3">Annuler</a>
    {{ form_end(form) }}
</div>
{% endblock %}
