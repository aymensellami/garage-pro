{# =========================================================
   THEME JAVASCRIPT
   ========================================================= #}

<script>

document.addEventListener('DOMContentLoaded', function () {

    const html = document.documentElement;

    const themeToggle =
        document.getElementById('themeToggle');

    const desktopThemeToggle =
        document.getElementById('desktopThemeToggle');

    const themeIcon =
        document.getElementById('themeIcon');

    const desktopThemeIcon =
        document.getElementById('desktopThemeIcon');

    const themeText =
        document.getElementById('themeText');


    /*
     * Récupération du thème sauvegardé
     */

    const savedTheme =
        localStorage.getItem('garagepro-theme') || 'light';


    html.setAttribute(
        'data-theme',
        savedTheme
    );


    /*
     * Mise à jour de l'interface
     */

    function updateThemeUI(theme) {

        if (theme === 'dark') {

            if (themeIcon) {

                themeIcon.className =
                    'bi bi-sun';

            }

            if (desktopThemeIcon) {

                desktopThemeIcon.className =
                    'bi bi-sun';

            }

            if (themeText) {

                themeText.textContent =
                    'Mode clair';

            }

        } else {

            if (themeIcon) {

                themeIcon.className =
                    'bi bi-moon-stars';

            }

            if (desktopThemeIcon) {

                desktopThemeIcon.className =
                    'bi bi-moon-stars';

            }

            if (themeText) {

                themeText.textContent =
                    'Mode sombre';

            }

        }

    }


    /*
     * Changer le thème
     */

    function toggleTheme() {

        const currentTheme =
            html.getAttribute('data-theme');


        const newTheme =
            currentTheme === 'dark'
                ? 'light'
                : 'dark';


        html.setAttribute(
            'data-theme',
            newTheme
        );


        localStorage.setItem(
            'garagepro-theme',
            newTheme
        );


        updateThemeUI(newTheme);

    }


    /*
     * Bouton thème sidebar
     */

    if (themeToggle) {

        themeToggle.addEventListener(
            'click',
            toggleTheme
        );

    }


    /*
     * Bouton thème topbar
     */

    if (desktopThemeToggle) {

        desktopThemeToggle.addEventListener(
            'click',
            toggleTheme
        );

    }


    /*
     * Initialisation
     */

    updateThemeUI(savedTheme);

});

</script>


