{% extends 'base.html.twig' %}
{% block title %}Fournisseurs — GaragePro{% endblock %}
{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-white">🚚 Fournisseurs</h2>
    <a href="{{ path('app_supplier_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Ajouter</a>
</div>
<div class="gp-card p-0 overflow-hidden">
    <table class="table table-dark-custom mb-0">
        <thead><tr><th>Nom</th><th>Contact</th><th>Email</th><th>Téléphone</th><th>Pièces</th></tr></thead>
        <tbody>
        {% for s in suppliers %}
            <tr>
                <td><strong>{{ s.name }}</strong></td>
                <td>{{ s.contactName ?: '-' }}</td>
                <td>{{ s.email ?: '-' }}</td>
                <td>{{ s.phone ?: '-' }}</td>
                <td>{{ s.parts|length }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
