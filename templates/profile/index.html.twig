{% extends 'base.html.twig' %}

{% block title %}Mon profil — GaragePro{% endblock %}

{% block body %}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="text-white mb-1">
            <i class="bi bi-person-circle me-2"></i>
            Mon profil
        </h2>

        <p class="text-muted mb-0">
            Modifier vos informations personnelles
        </p>
    </div>
</div>

<div class="row justify-content-center">

    <div class="col-xl-8 col-lg-10">

        <div class="gp-card p-4">

            <div class="d-flex align-items-center mb-4">

                <div
                    class="rounded-circle bg-primary d-flex align-items-center justify-content-center me-3"
                    style="width: 65px; height: 65px;"
                >
                    <i class="bi bi-person text-white fs-3"></i>
                </div>

                <div>
                    <h4 class="text-white mb-1">
                        {{ user.firstName }} {{ user.lastName }}
                    </h4>

                    <span class="badge bg-primary">
                        {% if 'ROLE_ADMIN' in user.roles %}
                            Administrateur
                        {% elseif 'ROLE_MECHANIC' in user.roles %}
                            Mécanicien
                        {% else %}
                            Utilisateur
                        {% endif %}
                    </span>
                </div>

            </div>

            <form method="post">

                <div class="row g-3">

                    {# Prénom #}
                    <div class="col-md-6">

                        <label for="firstName" class="form-label text-white">
                            Prénom
                        </label>

                        <input
                            type="text"
                            class="form-control"
                            id="firstName"
                            name="firstName"
                            value="{{ user.firstName }}"
                            required
                        >

                    </div>

                    {# Nom #}
                    <div class="col-md-6">

                        <label for="lastName" class="form-label text-white">
                            Nom
                        </label>

                        <input
                            type="text"
                            class="form-control"
                            id="lastName"
                            name="lastName"
                            value="{{ user.lastName }}"
                            required
                        >

                    </div>

                    {# Email #}
                    <div class="col-12">

                        <label for="email" class="form-label text-white">
                            Adresse email
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-envelope"></i>
                            </span>

                            <input
                                type="email"
                                class="form-control"
                                id="email"
                                name="email"
                                value="{{ user.email }}"
                                required
                            >

                        </div>

                    </div>

                </div>

                <hr class="border-secondary my-4">

                <h5 class="text-white mb-3">
                    <i class="bi bi-shield-lock me-2"></i>
                    Changer le mot de passe
                </h5>

                <p class="text-muted small">
                    Laissez les champs vides si vous ne souhaitez pas modifier
                    votre mot de passe.
                </p>

                <div class="row g-3">

                    <div class="col-md-6">

                        <label
                            for="newPassword"
                            class="form-label text-white"
                        >
                            Nouveau mot de passe
                        </label>

                        <input
                            type="password"
                            class="form-control"
                            id="newPassword"
                            name="newPassword"
                            minlength="8"
                            autocomplete="new-password"
                        >

                        <div class="form-text">
                            Minimum 8 caractères.
                        </div>

                    </div>

                    <div class="col-md-6">

                        <label
                            for="confirmPassword"
                            class="form-label text-white"
                        >
                            Confirmer le mot de passe
                        </label>

                        <input
                            type="password"
                            class="form-control"
                            id="confirmPassword"
                            name="confirmPassword"
                            minlength="8"
                            autocomplete="new-password"
                        >

                    </div>

                </div>

                <hr class="border-secondary my-4">

                <div class="d-flex justify-content-between">

                    <a
                        href="{{ path('app_dashboard') }}"
                        class="btn btn-outline-secondary"
                    >
                        <i class="bi bi-arrow-left me-2"></i>
                        Retour
                    </a>

                    <button
                        type="submit"
                        class="btn btn-primary"
                    >
                        <i class="bi bi-check-lg me-2"></i>
                        Enregistrer les modifications
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

{% endblock %}