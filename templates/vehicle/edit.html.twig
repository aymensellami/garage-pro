{% extends 'base.html.twig' %}
{% block title %}Modifier {{ vehicle.brand }} {{ vehicle.model }}{% endblock %}
{% block body %}
<h2 class="text-white mb-4">✏️ Modifier le véhicule</h2>
<div class="gp-card p-4">
    {{ form_start(form) }}
    <div class="row g-3">
        <div class="col-md-4">{{ form_row(form.brand) }}</div>
        <div class="col-md-4">{{ form_row(form.model) }}</div>
        <div class="col-md-4">{{ form_row(form.registration) }}</div>
        <div class="col-md-3">{{ form_row(form.year) }}</div>
        <div class="col-md-3">{{ form_row(form.mileage) }}</div>
        <div class="col-md-3">{{ form_row(form.fuelType) }}</div>
        <div class="col-md-3">{{ form_row(form.color) }}</div>
        <div class="col-md-6">{{ form_row(form.technicalControlDate) }}</div>
        <div class="col-md-6">{{ form_row(form.owner) }}</div>
    </div>
    <button class="btn btn-primary mt-3">Enregistrer</button>
    <a href="{{ path('app_vehicle_show', {id: vehicle.id}) }}" class="btn btn-outline-secondary mt-3">Annuler</a>
    {{ form_end(form) }}
</div>
{% endblock %}
