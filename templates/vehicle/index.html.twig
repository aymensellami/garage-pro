{% extends 'base.html.twig' %}
{% block title %}Véhicules — GaragePro{% endblock %}
{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-white">🚗 Parc automobile</h2>
    <a href="{{ path('app_vehicle_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Ajouter</a>
</div>
<div class="gp-card p-0 overflow-hidden">
    <table class="table table-dark-custom mb-0">
        <thead><tr><th>Véhicule</th><th>Immat</th><th>Km</th><th>Propriétaire</th><th>CT</th><th></th></tr></thead>
        <tbody>
        {% for v in vehicles %}
            <tr>
                <td><strong>{{ v.brand }} {{ v.model }}</strong><div class="small text-muted">{{ v.year }} · {{ v.fuelType|capitalize }}</div></td>
                <td class="font-monospace">{{ v.registration }}</td>
                <td>{{ v.mileage|number_format(0, ' ', ' ') }} km</td>
                <td>{{ v.owner.fullName }}</td>
                <td>{% if v.technicalControlValid %}<span class="badge badge-ok">OK</span>{% else %}<span class="badge badge-danger">Expiré</span>{% endif %}</td>
                <td><a href="{{ path('app_vehicle_show', {id: v.id}) }}" class="btn btn-sm btn-outline-primary">Détails</a></td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
