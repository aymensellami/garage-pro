{% extends 'base.html.twig' %}

{% block title %}Modifier {{ intervention.reference }} — GaragePro{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-white">
        <i class="bi bi-pencil-square me-2"></i>Modifier
        <span class="font-monospace text-info">{{ intervention.reference }}</span>
    </h2>
    <a href="{{ path('app_intervention_show', {id: intervention.id}) }}" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Retour
    </a>
</div>

<div class="gp-card p-4">
    {{ form_start(form) }}
        {{ form_widget(form) }}

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-1"></i>Enregistrer
            </button>
            <a href="{{ path('app_intervention_show', {id: intervention.id}) }}" class="btn btn-outline-secondary">
                Annuler
            </a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}