{% extends 'base.html.twig' %}
{% block title %}Facture {{ invoice.number }} — GaragePro{% endblock %}
{% block body %}
<div class="row g-4">
    <div class="col-md-8">
        <div class="gp-card p-4">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <h4 class="text-white font-monospace">{{ invoice.number }}</h4>
                    <div class="text-muted">Émise le {{ invoice.issuedAt|date('d/m/Y') }} · Échéance {{ invoice.dueDate|date('d/m/Y') }}</div>
                </div>
                <span class="badge {{ invoice.status == 'paid' ? 'bg-success' : (invoice.status == 'overdue' ? 'bg-danger' : 'bg-secondary') }} fs-6">{{ invoice.status }}</span>
            </div>
            <table class="table table-dark-custom">
                <thead><tr><th>Description</th><th class="text-end">Qté</th><th class="text-end">P.U. HT</th><th class="text-end">Total HT</th></tr></thead>
                <tbody>
                {% for line in invoice.lines %}
                    <tr><td>{{ line.label }}</td><td class="text-end">{{ line.quantity }}</td><td class="text-end">{{ line.unitPrice }} €</td><td class="text-end">{{ line.subtotalHT|number_format(2, ',', ' ') }} €</td></tr>
                {% endfor %}
                </tbody>
                <tfoot>
                    <tr><td colspan="3" class="text-end text-muted">Total HT</td><td class="text-end text-white fw-bold">{{ invoice.totalHT }} €</td></tr>
                    <tr><td colspan="3" class="text-end text-muted">TVA ({{ invoice.tvaRate }}%)</td><td class="text-end text-white">{{ (invoice.totalTTC - invoice.totalHT)|number_format(2, ',', ' ') }} €</td></tr>
                    <tr><td colspan="3" class="text-end text-white fs-5">Total TTC</td><td class="text-end text-white fs-5 fw-bold">{{ invoice.totalTTC }} €</td></tr>
                </tfoot>
            </table>
        </div>
    </div>
    <div class="col-md-4">
        <div class="gp-card p-4">
            <h5 class="text-white mb-3">Paiements</h5>
            {% for payment in invoice.payments %}
                <div class="d-flex justify-content-between border-bottom border-secondary pb-2 mb-2">
                    <div><div class="text-white">{{ payment.method|capitalize }}</div><div class="small text-muted">{{ payment.paidAt|date('d/m/Y H:i') }}</div></div>
                    <div class="text-success fw-bold">{{ payment.amount }} €</div>
                </div>
            {% endfor %}
            <div class="d-flex justify-content-between mt-3">
                <span class="text-muted">Reste dû</span>
                <span class="text-white fw-bold">{{ invoice.remainingAmount|number_format(2, ',', ' ') }} €</span>
            </div>
            {% if invoice.status != 'paid' %}
                <form method="post" action="{{ path('app_invoice_pay', {id: invoice.id}) }}" class="mt-3">
                    <div class="input-group">
                        <input type="number" step="0.01" name="amount" class="form-control" placeholder="Montant" required>
                        <select name="method" class="form-select" style="max-width:120px;">
                            <option value="cash">Espèces</option>
                            <option value="card">CB</option>
                            <option value="transfer">Virement</option>
                        </select>
                        <button class="btn btn-success">Payer</button>
                    </div>
                </form>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
