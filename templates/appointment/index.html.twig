{% extends 'base.html.twig' %}
{% block title %}Planning — GaragePro{% endblock %}
{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-white">📅 Rendez-vous</h2>
    <a href="{{ path('app_appointment_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Nouveau RDV</a>
</div>
<div class="gp-card p-0 overflow-hidden">
    <table class="table table-dark-custom mb-0">
        <thead><tr><th>Date</th><th>Véhicule</th><th>Motif</th><th>Statut</th><th></th></tr></thead>
        <tbody>
        {% for a in appointments %}
            <tr>
                <td>{{ a.scheduledAt|date('d/m/Y H:i') }}</td>
                <td>{{ a.vehicle.brand }} {{ a.vehicle.model }}</td>
                <td>{{ a.reason }}</td>
                <td><span class="badge {{ a.status == 'confirmed' ? 'bg-primary' : (a.status == 'completed' ? 'bg-success' : 'bg-secondary') }}">{{ a.status }}</span></td>
                <td>
                    {% if a.status == 'requested' %}
                        <form method="post" action="{{ path('app_appointment_confirm', {id: a.id}) }}" class="d-inline">
                            <button class="btn btn-sm btn-outline-success">Confirmer</button>
                        </form>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
