{% extends 'base.html.twig' %}
{% block title %}Gestion Utilisateurs — GaragePro{% endblock %}
{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-white"><i class="bi bi-people me-2"></i>Gestion des utilisateurs</h2>
    <a href="{{ path('app_admin_user_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Nouvel utilisateur</a>
</div>

<div class="gp-card p-0 overflow-hidden">
    <table class="table table-dark-custom mb-0">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nom</th>
                <th>Email</th>
                <th>Rôles</th>
                <th>Statut</th>
                <th>Créé le</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr>
                <td class="font-monospace text-muted">#{{ user.id }}</td>
                <td>
                    <div class="d-flex align-items-center gap-2">
                        <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center" style="width:32px;height:32px;">
                            <span class="text-white fw-bold small">{{ user.firstName|first }}{{ user.lastName|first }}</span>
                        </div>
                        <div>
                            <div class="text-white">{{ user.fullName }}</div>
                        </div>
                    </div>
                </td>
                <td>{{ user.email }}</td>
                <td>
                    {% for role in user.roles %}
                        {% if role != 'ROLE_USER' %}
                            <span class="badge {{ role == 'ROLE_ADMIN' ? 'bg-danger' : 'bg-info' }} me-1">{{ role|replace({'ROLE_': ''}) }}</span>
                        {% endif %}
                    {% endfor %}
                </td>
                <td>
                    {% if user.isActive %}
                        <span class="badge badge-ok"><i class="bi bi-check-circle me-1"></i>Actif</span>
                    {% else %}
                        <span class="badge badge-danger"><i class="bi bi-x-circle me-1"></i>Inactif</span>
                    {% endif %}
                </td>
                <td class="text-muted">{{ user.createdAt ? user.createdAt|date('d/m/Y') : '-' }}</td>
                <td class="text-end">
                    <a href="{{ path('app_admin_user_edit', {id: user.id}) }}" class="btn btn-sm btn-outline-primary me-1"><i class="bi bi-pencil"></i></a>
                    <form method="post" action="{{ path('app_admin_user_toggle', {id: user.id}) }}" class="d-inline" onsubmit="return confirm('Changer le statut de cet utilisateur ?')">
                        <button class="btn btn-sm btn-outline-{{ user.isActive ? 'warning' : 'success' }}">
                            <i class="bi bi-{{ user.isActive ? 'pause' : 'play' }}"></i>
                        </button>
                    </form>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
