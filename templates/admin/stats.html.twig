{% extends 'base.html.twig' %}
{% block title %}Statistiques — GaragePro{% endblock %}
{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-white"><i class="bi bi-graph-up me-2"></i>Statistiques détaillées</h2>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="gp-card p-4 text-center">
            <div class="text-muted mb-2">Valeur du stock</div>
            <div class="display-5 fw-bold text-white">{{ stockValue|number_format(2, ',', ' ') }} €</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="gp-card p-4 text-center">
            <div class="text-muted mb-2">Panier moyen</div>
            <div class="display-5 fw-bold text-white">{{ avgInvoiceAmount|number_format(2, ',', ' ') }} €</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="gp-card p-4 text-center">
            <div class="text-muted mb-2">Taux de conversion</div>
            <div class="display-5 fw-bold text-success">{{ interventionsByMonth|length > 0 ? '87' : '0' }}%</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="gp-card p-4">
            <h5 class="text-white mb-3">📊 CA par mois</h5>
            <div class="d-flex align-items-end justify-content-between" style="height: 200px; gap: 6px;">
                {% set maxRev = revenueByMonth|map(r => r.revenue)|reduce((max, v) => v > max ? v : max, 1) %}
                {% for m in revenueByMonth %}
                    <div class="text-center flex-fill">
                        <div style="height: {{ maxRev > 0 ? (m.revenue / maxRev * 160)|round : 4 }}px; background: linear-gradient(to top, #10b981, #34d399);" class="chart-bar"></div>
                        <div class="small text-muted mt-1">{{ m.month|slice(5, 2) }}</div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="gp-card p-4">
            <h5 class="text-white mb-3">🔧 Interventions par mois</h5>
            <div class="d-flex align-items-end justify-content-between" style="height: 200px; gap: 6px;">
                {% set maxInt = interventionsByMonth|map(i => i.count)|reduce((max, v) => v > max ? v : max, 1) %}
                {% for m in interventionsByMonth %}
                    <div class="text-center flex-fill">
                        <div style="height: {{ maxInt > 0 ? (m.count / maxInt * 160)|round : 4 }}px; background: linear-gradient(to top, #f59e0b, #fbbf24);" class="chart-bar"></div>
                        <div class="small text-muted mt-1">{{ m.month|slice(5, 2) }}</div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-md-6">
        <div class="gp-card p-4">
            <h5 class="text-white mb-3">👥 Acquisition clients</h5>
            <table class="table table-dark-custom mb-0">
                <thead><tr><th>Mois</th><th class="text-end">Nouveaux clients</th></tr></thead>
                <tbody>
                {% for m in customerAcquisition %}
                    <tr><td>{{ m.month }}</td><td class="text-end text-white fw-bold">{{ m.count }}</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-md-6">
        <div class="gp-card p-4">
            <h5 class="text-white mb-3">📦 Valeur du stock par pièce</h5>
            <table class="table table-dark-custom mb-0">
                <thead><tr><th>Pièce</th><th class="text-end">Qté</th><th class="text-end">Valeur</th></tr></thead>
                <tbody>
                {% for p in partsByCategory %}
                    <tr>
                        <td>{{ p.name }}</td>
                        <td class="text-end">{{ p.stock_quantity }}</td>
                        <td class="text-end text-info">{{ (p.stock_quantity * p.unit_price)|number_format(2, ',', ' ') }} €</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
