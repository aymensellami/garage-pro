{% extends 'base.html.twig' %}

{% block title %}Panel Administration — GaragePro{% endblock %}

{% block body %}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="text-white mb-1">
            <i class="bi bi-shield-lock me-2"></i>
            Panel Administration
        </h2>

        <p class="text-muted mb-0">
            Gestion globale de GaragePro
        </p>
    </div>

    <span class="text-muted">
        {{ "now"|date('d/m/Y H:i') }}
    </span>
</div>

<!-- ===================== -->
<!-- STATISTIQUES GLOBALES -->
<!-- ===================== -->

<div class="row g-4 mb-4">

    {% set statCards = [
        {
            icon: 'people',
            label: 'Utilisateurs',
            value: globalStats.totalUsers,
            color: 'primary'
        },
        {
            icon: 'person-check',
            label: 'Clients',
            value: globalStats.totalCustomers,
            color: 'success'
        },
        {
            icon: 'car-front',
            label: 'Véhicules',
            value: globalStats.totalVehicles,
            color: 'info'
        },
        {
            icon: 'tools',
            label: 'Interventions',
            value: globalStats.totalInterventions,
            color: 'warning'
        },
        {
            icon: 'receipt',
            label: 'Factures',
            value: globalStats.totalInvoices,
            color: 'danger'
        },
        {
            icon: 'box-seam',
            label: 'Pièces',
            value: globalStats.totalParts,
            color: 'secondary'
        },
        {
            icon: 'currency-euro',
            label: 'CA Total',
            value: globalStats.totalRevenue|number_format(2, ',', ' ') ~ ' €',
            color: 'success'
        },
        {
            icon: 'wrench',
            label: 'Mécaniciens',
            value: globalStats.activeMechanics,
            color: 'primary'
        }
    ] %}

    {% for card in statCards %}

        <div class="col-12 col-sm-6 col-lg-3">

            <div class="gp-card p-3 h-100 stat-card">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <div class="text-muted small">
                            {{ card.label }}
                        </div>

                        <div class="fs-4 fw-bold text-white">
                            {{ card.value }}
                        </div>

                    </div>

                    <i class="bi bi-{{ card.icon }}
                              fs-1 text-{{ card.color }}
                              opacity-50">
                    </i>

                </div>

            </div>

        </div>

    {% endfor %}

</div>


<!-- ===================== -->
<!-- CA + TOP CLIENTS -->
<!-- ===================== -->

<div class="row g-4">

    <!-- Chiffre d'affaires -->

    <div class="col-lg-8">

        <div class="gp-card p-4 h-100">

            <h5 class="text-white mb-4">
                <i class="bi bi-graph-up-arrow me-2"></i>
                Chiffre d'affaires
                <span class="text-muted fs-6">
                    (12 derniers mois)
                </span>
            </h5>

            <div
                class="d-flex align-items-end justify-content-between"
                style="height: 220px; gap: 8px;"
            >

                {% set maxRev = 1 %}

                {% for row in revenueByMonth %}

                    {% if row.revenue > maxRev %}
                        {% set maxRev = row.revenue %}
                    {% endif %}

                {% endfor %}


                {% for month in revenueByMonth %}

                    {% set barHeight =
                        maxRev > 0
                            ? ((month.revenue / maxRev) * 180)|round
                            : 4
                    %}

                    <div
                        class="text-center flex-fill"
                        style="min-width: 40px;"
                    >

                        <div class="small text-white mb-1">
                            {{ month.revenue|number_format(0, ',', ' ') }}
                        </div>

                        <div
                            class="chart-bar"
                            style="
                                height: {{ barHeight }}px;
                                background:
                                    linear-gradient(
                                        to top,
                                        #3b82f6,
                                        #06b6d4
                                    );
                                border-radius: 6px 6px 0 0;
                            "
                        ></div>

                        <div class="small text-muted mt-2">

                            {{ month.month|slice(5, 2) }}/
                            {{ month.month|slice(0, 4) }}

                        </div>

                    </div>

                {% endfor %}

            </div>

        </div>

    </div>


    <!-- Top clients -->

    <div class="col-lg-4">

        <div class="gp-card p-4 h-100">

            <h5 class="text-white mb-3">
                <i class="bi bi-trophy me-2"></i>
                Top Clients
            </h5>

            {% for customer in topCustomers %}

                <div
                    class="d-flex justify-content-between
                           align-items-center
                           border-bottom border-secondary
                           py-3"
                >

                    <div>

                        <div class="text-white">
                            {{ customer.first_name }}
                            {{ customer.last_name }}
                        </div>

                    </div>

                    <div class="text-success fw-bold">
                        {{ customer.total|number_format(2, ',', ' ') }} €
                    </div>

                </div>

            {% else %}

                <p class="text-muted">
                    Aucun client enregistré.
                </p>

            {% endfor %}

        </div>

    </div>

</div>


<!-- ===================== -->
<!-- MECANICIENS + STATUT -->
<!-- ===================== -->

<div class="row g-4 mt-1">

    <!-- Top mécaniciens -->

    <div class="col-lg-6">

        <div class="gp-card p-4 h-100">

            <h5 class="text-white mb-3">
                <i class="bi bi-tools me-2"></i>
                Top Mécaniciens
            </h5>

            <div class="table-responsive">

                <table class="table table-dark-custom mb-0">

                    <thead>
                        <tr>
                            <th>Mécanicien</th>
                            <th class="text-end">
                                Interventions
                            </th>
                            <th class="text-end">
                                CA généré
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                    {% for mec in topMechanics %}

                        <tr>

                            <td>
                                {{ mec.first_name }}
                                {{ mec.last_name }}
                            </td>

                            <td class="text-end">
                                {{ mec.count }}
                            </td>

                            <td class="text-end text-info">
                                {{ mec.revenue|number_format(2, ',', ' ') }}
                                €
                            </td>

                        </tr>

                    {% else %}

                        <tr>
                            <td
                                colspan="3"
                                class="text-center text-muted"
                            >
                                Aucun mécanicien.
                            </td>
                        </tr>

                    {% endfor %}

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- Interventions par statut -->

    <div class="col-lg-3">

        <div class="gp-card p-4 h-100">

            <h5 class="text-white mb-4">
                <i class="bi bi-bar-chart me-2"></i>
                Interventions
            </h5>

            {% for status, count in interventionsByStatus %}

                <div
                    class="d-flex
                           justify-content-between
                           align-items-center
                           mb-2"
                >

                    <span class="text-muted">
                        {{ status|capitalize }}
                    </span>

                    <span class="badge bg-primary">
                        {{ count }}
                    </span>

                </div>

                <div
                    class="progress mb-3"
                    style="
                        height: 6px;
                        background: #334155;
                    "
                >

                    <div
                        class="progress-bar"
                        style="
                            width: {{ count > 0 ? 100 : 0 }}%;
                        "
                    ></div>

                </div>

            {% else %}

                <p class="text-muted">
                    Aucune intervention.
                </p>

            {% endfor %}

        </div>

    </div>


    <!-- Actions rapides -->

    <div class="col-lg-3">

        <div class="gp-card p-4 h-100">

            <h5 class="text-white mb-4">
                <i class="bi bi-lightning-charge me-2"></i>
                Actions rapides
            </h5>

            <a
                href="{{ path('app_admin_users') }}"
                class="btn btn-outline-primary w-100 mb-2"
            >
                <i class="bi bi-people me-2"></i>
                Utilisateurs
            </a>

            <a
                href="{{ path('app_admin_stats') }}"
                class="btn btn-outline-info w-100 mb-2"
            >
                <i class="bi bi-graph-up me-2"></i>
                Statistiques
            </a>

            <a
                href="{{ path('app_admin_settings') }}"
                class="btn btn-outline-secondary w-100"
            >
                <i class="bi bi-gear me-2"></i>
                Paramètres
            </a>

        </div>

    </div>

</div>

{% endblock %}